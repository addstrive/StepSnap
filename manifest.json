{
  "manifest_version": 3,
  "name": "StepSnap – Auto Guide Recorder",
  "version": "1.0.0",
  "description": "Record browser actions and export beautiful step-by-step guides instantly.",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "storage",
    "desktopCapture"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "StepSnap"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["capture.html", "dashboard.html", "icons/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
